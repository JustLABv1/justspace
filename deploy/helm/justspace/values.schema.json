{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "frontend", "backend", "ingress", "customCA", "postgresql"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["publicUrl"],
      "properties": { "publicUrl": { "type": "string" }, "imagePullSecrets": { "type": "array" } }
    },
    "frontend": {
      "type": "object",
      "required": ["image"],
      "properties": { "image": { "$ref": "#/definitions/image" }, "apiUrl": { "type": "string" }, "wsUrl": { "type": "string" }, "podSecurityContext": { "type": "object" }, "containerSecurityContext": { "type": "object" } }
    },
    "backend": {
      "type": "object",
      "required": ["replicaCount", "image", "existingSecret", "externalDatabase", "persistence"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "existingSecret": { "$ref": "#/definitions/secretReference" },
        "externalDatabase": {
          "type": "object",
          "required": ["host", "port", "database", "user", "existingSecret", "sslMode"],
          "properties": {
            "host": { "type": "string" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string" }, "user": { "type": "string" },
            "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] }, "existingSecret": { "$ref": "#/definitions/secretReference" }
          }
        }
      }
    },
    "customCA": {
      "type": "object",
      "required": ["enabled", "existingConfigMap", "existingSecret", "key"],
      "properties": { "enabled": { "type": "boolean" }, "existingConfigMap": { "type": "string" }, "existingSecret": { "type": "string" }, "key": { "type": "string", "minLength": 1 } }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host", "tls"],
      "properties": { "enabled": { "type": "boolean" }, "host": { "type": "string" }, "tls": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "existingSecret": { "type": "string" } } } }
    },
    "postgresql": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } }
  },
  "definitions": {
    "image": { "type": "object", "required": ["repository", "tag", "digest"], "properties": { "repository": { "type": "string", "minLength": 1 }, "tag": { "type": "string" }, "digest": { "type": "string" } } },
    "secretReference": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
  }
}
