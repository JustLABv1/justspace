# Local Docker Compose configuration. This topology is for development and
# testing only; use the Helm chart with a TLS-enabled external PostgreSQL DB in production.
BACKEND_IMAGE=ghcr.io/justlabv1/justspace:backend-REPLACE_WITH_RELEASE
FRONTEND_IMAGE=ghcr.io/justlabv1/justspace:frontend-REPLACE_WITH_RELEASE
POSTGRES_IMAGE=postgres:18-alpine
PERMISSIONS_IMAGE=alpine:3.20

DB_USER=justspace
DB_PASSWORD=replace-with-a-local-password
DB_NAME=justspace
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
OIDC_ENCRYPTION_KEY=replace-with-a-separate-random-key
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
MAX_UPLOAD_BYTES=52428800

# Used only with docker-compose.custom-ca.yml. It must point to a PEM bundle.
# CUSTOM_CA_CERT_FILE=./certs/company-ca.pem
